www.shienshi.com {
	redir https://shienshi.com{uri} permanent
}

shienshi.com {
	root * /var/www/html/public
	encode zstd gzip

	# 誤配置された機密ファイルへのアクセスを拒否
	@forbidden {
		path /.env /.env.* /.git/* /.svn/* /.hg/*
		path /composer.json /composer.lock /package.json /package-lock.json
		path /Dockerfile /docker-compose.yml /docker-compose.*.yml
	}
	respond @forbidden 404

	# セキュリティヘッダー
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains" # HTTPS接続を強制
		X-Content-Type-Options nosniff # MIME typeの推測をさせない
		Referrer-Policy "strict-origin-when-cross-origin" # パスやクエリを別ドメインには伝えない
		X-Frame-Options "DENY" # iframeへの埋め込みを禁止
		Permissions-Policy "camera=(), microphone=(), geolocation=()" # カメラ・マイク・位置情報の使用を禁止
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" # CSP設定
		-Server # Webサーバーの種類を表示しない
	}

	# Viteのハッシュ付きファイル
	@vite_build path /build/*
	header @vite_build Cache-Control "public, max-age=31536000, immutable"

	# Laravelへ
	php_fastcgi app:9000

	# public配下の静的ファイル
	file_server
}
