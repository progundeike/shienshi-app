www.shienshi.com {
	redir https://shienshi.com{uri} permanent
}

shienshi.com {
	root * /var/www/html/public
	encode zstd gzip

	@vite_build {
		path /build/*
	}
	header @vite_build Cache-Control "public, max-age=31536000, immutable"

	route {
		try_files {path} {path}/ /index.php?{query} /index.html
		header /index.html Cache-Control "no-store"
	}

	# Laravelへ
	php_fastcgi app:9000

	# public配下の静的ファイル
	file_server
}
